{
  "name": "agent-demo-kit",
  "version": "0.1.0",
  "description": "Watchable, URL-triggered demos and browser checks for React apps",
  "type": "module",
  "license": "MIT",
  "files": ["dist", "README.md", "LICENSE"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./react": { "types": "./dist/react.d.ts", "import": "./dist/react.js" }
  },
  "bin": { "agent-demo": "./dist/cli.js" },
  "scripts": {
    "build": "tsup src/index.ts src/react.tsx src/cli.ts --format esm --dts --clean",
    "prepare": "npm run build",
    "dev": "vite --config example/vite.config.ts",
    "site": "vite landing --port 4174 --strictPort",
    "e2e": "node scripts/e2e.mjs"
  },
  "peerDependencies": { "react": ">=18", "react-dom": ">=18" },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
